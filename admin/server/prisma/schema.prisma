generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  REGISTRATION_MANAGER
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String
  name             String
  role             Role
  isActive         Boolean              @default(true)
  failedLoginCount Int                  @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessions         Session[]
  resetTokens      PasswordResetToken[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Direction {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  events    Event[]
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  events    Event[]
}

model Specialty {
  id            String         @id @default(cuid())
  name          String         @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  registrations Registration[]
}

enum EventFormat {
  CONGRESS
  CONFERENCE
  SEMINAR
  EXHIBITION
  ONLINE_SYMPOSIUM
}

enum AttendanceMode {
  OFFLINE
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

model Event {
  id                    String                @id @default(cuid())
  title                 String
  slug                  String                @unique
  subtitle              String?
  format                EventFormat
  attendanceMode        AttendanceMode        @default(OFFLINE)
  status                EventStatus           @default(DRAFT)
  startDate             DateTime              @db.Date
  endDate               DateTime              @db.Date
  cityId                String?
  city                  City?                 @relation(fields: [cityId], references: [id], onDelete: SetNull)
  directions            Direction[]
  nmoPoints             Int?
  expectedParticipants  Int?
  description           String?
  keyFacts              Json                  @default("[]")
  organizers            String?
  venueName             String?
  venueAddress          String?
  venueHowToGet         String?
  venueParking          String?
  venueAccommodation    String?
  venueLat              Float?
  venueLng              Float?
  registrationEnabled   Boolean               @default(true)
  registrationDeadline  DateTime?
  maxParticipants       Int?
  showRegistrationCount Boolean               @default(false)
  registrationFormats   ParticipationFormat[] @default([OFFLINE, ONLINE])
  registrationFields    Json                  @default("{}")
  confirmationText      String?
  seoTitle              String?
  seoDescription        String?
  archivedAt            DateTime?
  deletedAt             DateTime?
  publishedAt           DateTime?
  createdById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tariffs               EventTariff[]
  halls                 Hall[]
  programDays           ProgramDay[]
  speakers              EventSpeaker[]
  registrations         Registration[]
  news                  News[]
  documents             Document[]
  partners              EventPartner[]

  @@index([startDate])
  @@index([deletedAt])
}

model EventTariff {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sortOrder Int
  name      String
  audience  String?
  price     Int?
  includes  String?

  @@index([eventId])
}

model Speaker {
  id            String           @id @default(cuid())
  lastName      String
  firstName     String
  middleName    String?
  degree        String?
  position      String?
  city          String?
  bio           String?
  photoUrl      String?
  photoThumbUrl String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  events        EventSpeaker[]
  sessions      SessionSpeaker[]

  @@index([lastName])
}

enum EventSpeakerRole {
  CHAIR
  CO_CHAIR
  COMMITTEE
  SPEAKER
}

model EventSpeaker {
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakerId String
  speaker   Speaker          @relation(fields: [speakerId], references: [id], onDelete: Restrict)
  role      EventSpeakerRole @default(SPEAKER)
  sortOrder Int

  @@id([eventId, speakerId])
}

model Hall {
  id        String           @id @default(cuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  sessions  ProgramSession[]

  @@index([eventId])
}

model ProgramDay {
  id       String           @id @default(cuid())
  eventId  String
  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date     DateTime         @db.Date
  title    String?
  sessions ProgramSession[]

  @@unique([eventId, date])
}

enum SessionKind {
  SESSION
  BREAK
}

model ProgramSession {
  id          String           @id @default(cuid())
  dayId       String
  day         ProgramDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  hallId      String?
  hall        Hall?            @relation(fields: [hallId], references: [id], onDelete: SetNull)
  kind        SessionKind      @default(SESSION)
  startTime   String
  endTime     String
  title       String
  description String?
  nmo         Boolean          @default(false)
  sortOrder   Int
  speakers    SessionSpeaker[]

  @@index([dayId])
}

enum SessionSpeakerRole {
  MODERATOR
  SPEAKER
}

model SessionSpeaker {
  sessionId String
  session   ProgramSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerId String
  speaker   Speaker            @relation(fields: [speakerId], references: [id], onDelete: Restrict)
  role      SessionSpeakerRole @default(SPEAKER)
  sortOrder Int

  @@id([sessionId, speakerId])
}

enum ParticipationFormat {
  OFFLINE
  ONLINE
  EXHIBITOR
  SPEAKER
}

enum RegistrationStatus {
  NEW
  CONFIRMED
  REJECTED
}

enum RegistrationSource {
  SITE
  MANUAL
}

model Registration {
  id                  String              @id @default(cuid())
  eventId             String
  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lastName            String
  firstName           String
  middleName          String?
  email               String
  phone               String
  specialtyId         String?
  specialty           Specialty?          @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  specialtyName       String
  workplace           String?
  position            String?
  city                String
  format              ParticipationFormat
  snils               String?
  consentPersonalData Boolean
  consentAt           DateTime
  consentMailing      Boolean             @default(false)
  status              RegistrationStatus  @default(NEW)
  statusChangedAt     DateTime?
  statusChangedById   String?
  source              RegistrationSource  @default(SITE)
  managerComment      String?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([createdAt])
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model News {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  excerpt        String?
  body           String?
  coverUrl       String?
  coverThumbUrl  String?
  eventId        String?
  event          Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status         NewsStatus  @default(DRAFT)
  publishAt      DateTime?
  seoTitle       String?
  seoDescription String?
  deletedAt      DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  images         NewsImage[]

  @@index([status, publishAt])
  @@index([deletedAt])
}

model NewsImage {
  id        String  @id @default(cuid())
  newsId    String
  news      News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String
  caption   String?
  sortOrder Int

  @@index([newsId])
}

model Document {
  id               String   @id @default(cuid())
  publicId         String   @unique
  title            String
  description      String?
  fileKey          String
  originalName     String
  extension        String
  mimeType         String
  size             Int
  fileUpdatedAt    DateTime @default(now())
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventSortOrder   Int      @default(0)
  svedenSection    String?
  sectionSortOrder Int      @default(0)
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([eventId, eventSortOrder])
  @@index([svedenSection, sectionSortOrder])
}

model Partner {
  id            String         @id @default(cuid())
  name          String
  url           String?
  description   String?
  logoUrl       String?
  logoThumbUrl  String?
  showOnHome    Boolean        @default(false)
  homeSortOrder Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  events        EventPartner[]

  @@index([name])
}

enum PartnerLevel {
  GENERAL
  OFFICIAL
  INFO
}

model EventPartner {
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  level     PartnerLevel
  sortOrder Int

  @@id([eventId, partnerId])
}
