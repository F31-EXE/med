DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/med_expo_admin?schema=public"
# SHADOW_DATABASE_URL нужен только если сервер БД не даёт создавать базы (например, prisma dev)
SHADOW_DATABASE_URL=
PORT=4000
# Адрес админки (ссылки в письмах сброса пароля и приглашениях)
APP_URL="http://localhost:5173/admin"
# Адрес сайта (canonical, sitemap.xml, Open Graph)
SITE_URL="http://localhost:4000"
# Номер счётчика Яндекс.Метрики; пусто — счётчик не подключается
METRIKA_ID=
NODE_ENV=development
# Vercel Blob: если задан, загруженные файлы хранятся в нём, иначе на диске в UPLOADS_DIR
BLOB_READ_WRITE_TOKEN=
# Секрет для Vercel Cron (/api/cron/purge)
CRON_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Media Expo Group <noreply@med-expo.org>"

SEED_ADMIN_EMAIL="admin@med-expo.org"
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Администратор"
